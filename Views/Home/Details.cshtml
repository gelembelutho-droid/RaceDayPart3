@model RaceDay.MVC.ViewModels.EventDto
@{
    ViewData["Title"] = Model.EventName;
}

<div class="container mt-4">
    <h1>@Model.EventName</h1>
    <p class="lead">@Model.Description</p>
    <p><strong>Date:</strong> @Model.EventDate.ToLongDateString()</p>
    <p><strong>Location:</strong> @Model.Location, @Model.City</p>

    <hr />
    <h3>Available Categories</h3>
    <div class="list-group mt-3">
        @foreach (var race in Model.Races)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">@race.RaceName</h5>
                    <small class="text-muted">@race.DistanceKm km</small>
                </div>

                @if (Context.Session.GetString("UserRole") == "Participant")
                {
                    <form asp-controller="Participant" asp-action="Enrol" method="post">
                        <input type="hidden" name="raceId" value="@race.RaceId" />
                        <input type="hidden" name="eventId" value="@Model.EventId" />
                        <button type="submit" class="btn btn-success">Enrol Now</button>
                    </form>
                }
                else
                {
                    <span class="badge bg-secondary">Login as Participant to Enrol</span>
                }
            </div>
        }
    </div>
</div>