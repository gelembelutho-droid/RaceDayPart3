@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">🏃‍♂️ RaceDay</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Left Side Menu -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @try
                        {
                            var token = Context.Session.GetString("JWToken");
                            var role = Context.Session.GetString("UserRole");

                            if (!string.IsNullOrEmpty(token))
                            {
                                if (role == "Organiser")
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a>
                                    </li>
                                }
                                else if (role == "Participant")
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Participant" asp-action="MyRaces">My Races</a>
                                    </li>
                                }
                            }
                        }
                        catch { /* Ignore session errors if API is down */ }
                    </ul>

                    <!-- Right Side Menu (Auth) -->
                    <ul class="navbar-nav">
                        @try
                        {
                            var token = Context.Session.GetString("JWToken");
                            var userName = Context.Session.GetString("UserName");

                            if (string.IsNullOrEmpty(token))
                            {
                                <li class="nav-item">
    <a class="nav-link text-dark" href="/Account/Login">Login</a>
</li>
<li class="nav-item">
    <a class="nav-link text-primary fw-bold" href="/Account/Register">Register</a>
</li>                                
                            }
                            else
                            {
                                <li class="nav-item">
                                    <span class="nav-link text-dark">Hello, <strong>@userName</strong>!</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">Logout</a>
                                </li>
                            }
                        }
                        catch { /* Ignore session errors */ }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            &copy; 2026 - RaceDay - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Scripts MUST be here for buttons to work -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>